{
  "name": "lobster-utility",
  "version": "0.1.0",
  "description": "Il cockpit del vibe-coder — gestione porte, Docker, terminali per non-tecnici",
  "author": "Lorenzo Stillittano",
  "license": "MIT",
  "main": "dist/main/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:electron": "sleep 3 && NODE_ENV=development electron .",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.json",
    "lint": "eslint src/",
    "package": "electron-builder --mac",
    "clean": "rm -rf dist out"
  },
  "dependencies": {
    "dockerode": "^4.0.4",
    "electron-store": "^6.0.1",
    "zustand": "^4.5.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "lucide-react": "^0.460.0",
    "recharts": "^2.13.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.34",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.0",
    "eslint": "^9.15.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "@vitejs/plugin-react": "^4.3.4"
  },
  "build": {
    "appId": "com.lobster.manager",
    "productName": "Lobster Manager",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": ["dmg"],
      "icon": "assets/icons/icon.icns"
    },
    "directories": {
      "output": "out"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ]
  }
}
